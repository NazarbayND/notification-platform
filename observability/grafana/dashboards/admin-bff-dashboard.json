{
  "uid": "notification-platform-admin-bff",
  "title": "Admin BFF Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "timeseries", "title": "Admin requests/sec", "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{service=\"admin-bff-service\"}[1m])) by (uri)", "legendFormat": "{{uri}}" }] },
    { "type": "timeseries", "title": "Admin average latency", "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 }, "targets": [{ "expr": "sum by (endpoint) (rate(admin_bff_request_duration_seconds_sum[5m])) / clamp_min(sum by (endpoint) (rate(admin_bff_request_duration_seconds_count[5m])), 0.001)", "legendFormat": "{{endpoint}}" }] },
    { "type": "timeseries", "title": "Downstream errors by service", "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(admin_bff_downstream_error_total[5m])) by (service)", "legendFormat": "{{service}}" }] },
    { "type": "timeseries", "title": "Dashboard stats average latency", "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 }, "targets": [{ "expr": "sum(rate(admin_bff_request_duration_seconds_sum{endpoint=\"dashboard\"}[5m])) / clamp_min(sum(rate(admin_bff_request_duration_seconds_count{endpoint=\"dashboard\"}[5m])), 0.001)" }] }
  ]
}
