{
  "uid": "notification-platform-workers",
  "title": "Worker Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "timeseries", "title": "Consumed messages/sec by worker", "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(worker_messages_consumed_total[1m])) by (service, channel)", "legendFormat": "{{service}} {{channel}}" }] },
    { "type": "timeseries", "title": "Processed messages/sec", "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(worker_messages_processed_total[1m])) by (service, channel)", "legendFormat": "{{service}} {{channel}}" }] },
    { "type": "timeseries", "title": "Failed messages/sec", "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(worker_messages_failed_total[1m])) by (service, channel, reason)", "legendFormat": "{{service}} {{channel}} {{reason}}" }] },
    { "type": "timeseries", "title": "Duplicate skipped/sec", "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(worker_duplicate_events_skipped_total[1m])) by (service, channel)", "legendFormat": "{{service}} {{channel}}" }] },
    { "type": "timeseries", "title": "Processing duration p95", "gridPos": { "x": 8, "y": 6, "w": 8, "h": 6 }, "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(worker_processing_duration_seconds_bucket[5m])) by (le, service, channel))", "legendFormat": "{{service}} {{channel}}" }] },
    { "type": "timeseries", "title": "Delivery attempts by status", "gridPos": { "x": 16, "y": 6, "w": 8, "h": 6 }, "targets": [{ "expr": "sum(rate(delivery_attempt_total[1m])) by (channel, provider, status)", "legendFormat": "{{channel}} {{provider}} {{status}}" }] },
    { "type": "timeseries", "title": "Provider request duration p95", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 }, "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(provider_request_duration_seconds_bucket[5m])) by (le, channel, provider))", "legendFormat": "{{channel}} {{provider}}" }] },
    { "type": "timeseries", "title": "Provider errors by code", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 }, "targets": [{ "expr": "sum(rate(provider_error_total[5m])) by (channel, provider, errorCode)", "legendFormat": "{{channel}} {{provider}} {{errorCode}}" }] }
  ]
}
