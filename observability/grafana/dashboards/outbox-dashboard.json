{
  "uid": "notification-platform-outbox",
  "title": "Outbox Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "stat", "title": "Pending events", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }, "targets": [{ "expr": "outbox_pending_total" }] },
    { "type": "stat", "title": "Processing events", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 }, "targets": [{ "expr": "outbox_processing_total" }] },
    { "type": "timeseries", "title": "Published events/sec", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 }, "targets": [{ "expr": "rate(outbox_published_total[1m])" }] },
    { "type": "timeseries", "title": "Failed events/sec", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 }, "targets": [{ "expr": "rate(outbox_failed_total[1m])" }] },
    { "type": "stat", "title": "Dead-letter count", "gridPos": { "x": 0, "y": 5, "w": 6, "h": 5 }, "targets": [{ "expr": "outbox_dead_letter_total" }] },
    { "type": "timeseries", "title": "Retry scheduled count", "gridPos": { "x": 6, "y": 5, "w": 6, "h": 5 }, "targets": [{ "expr": "increase(outbox_retry_scheduled_total[15m])" }] },
    { "type": "timeseries", "title": "Batch size", "gridPos": { "x": 12, "y": 5, "w": 6, "h": 5 }, "targets": [{ "expr": "outbox_publish_batch_size" }] },
    { "type": "timeseries", "title": "Publish duration p95", "gridPos": { "x": 18, "y": 5, "w": 6, "h": 5 }, "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(outbox_publish_duration_seconds_bucket[5m])) by (le))" }] },
    { "type": "stat", "title": "Oldest pending event age", "gridPos": { "x": 0, "y": 10, "w": 8, "h": 5 }, "targets": [{ "expr": "outbox_oldest_pending_age_seconds" }] }
  ]
}
